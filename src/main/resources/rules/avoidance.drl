end


// The avoidance is decided at 50 m: inside the 60 m over which the blind-spot sensor
// reports hazards in the side lanes (BlindSpotSensor.HAZARD_LOOKAHEAD_METERS), so a side
// found clear is clear for the whole manoeuvre. Deciding from further away would move the
// vehicle into a lane it cannot yet see into. Until then the obstacle stop rule
// (road-hazards.drl) keeps the speed on the comfortable braking curve, so the vehicle
// reaches 50 m at a speed from which it can still stop should no side be clear.
rule "Avoid obstacle in centre lane by changing left"
agenda-group "decision"
salience 470
when
    $ctx : DecisionContext()
    VehicleStateFact(lane == Lane.CENTER)
    ObstacleStateFact(obstacleId != "none", lane == Lane.CENTER,
                      $distance : distanceMeters > 0, distanceMeters <= 50.0)
    safeToChangeLane(Lane.LEFT;)
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.CHANGE_LANE_LEFT,
        Double.NaN,
        RiskLevel.LOW,
        DecisionPriority.COLLISION_AVOIDANCE,
        "Avoiding obstacle by moving into the clear left lane",
        drools.getRule().getName(),
        "obstacle " + $distance + "m ahead in own lane, left lane clear"
    );
end

rule "Avoid obstacle in centre lane by changing right when left is occupied"
agenda-group "decision"
salience 470
when
    $ctx : DecisionContext()
    VehicleStateFact(lane == Lane.CENTER)
    ObstacleStateFact(obstacleId != "none", lane == Lane.CENTER,
                      $distance : distanceMeters > 0, distanceMeters <= 50.0)
    // Right only when left is not a safe way past: occupied, or clear with no room to
    // follow the vehicle ahead in it (Art. 35 and 18 CE).
    not SafeLaneSide(side == Lane.LEFT)
    safeToChangeLane(Lane.RIGHT;)
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.CHANGE_LANE_RIGHT,
        Double.NaN,
        RiskLevel.LOW,
        DecisionPriority.COLLISION_AVOIDANCE,
        "Avoiding obstacle by moving into the clear right lane",
        drools.getRule().getName(),
        "obstacle " + $distance + "m ahead in own lane, left occupied, right clear"
    );
end

