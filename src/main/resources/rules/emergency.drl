package rules

import com.one2drive.projeto1.decision.DecisionContext
import com.one2drive.projeto1.decision.DecisionPriority
import com.one2drive.projeto1.domain.DrivingAction
import com.one2drive.projeto1.domain.PedestrianCrossingState
import com.one2drive.projeto1.domain.RiskLevel
import com.one2drive.projeto1.drools.DroolsSupport
import com.one2drive.projeto1.drools.events.ObstacleDetectedEvent
import com.one2drive.projeto1.drools.events.TTCEvent
import com.one2drive.projeto1.drools.facts.PedestrianStateFact
import com.one2drive.projeto1.drools.facts.VehicleStateFact
global DroolsSupport droolsSupport

// Every rule here is re-evaluated each decision cycle, so stream patterns are bounded
// by sliding windows: only recent samples count, and an accumulate yields one match
// per cycle instead of one per event still alive in the stream.
rule "Emergency brake when persistent TTC is critical"
agenda-group "decision"
salience 900
when
    $ctx : DecisionContext()
    accumulate(
        TTCEvent( $sample : ttcSeconds > 0.0, ttcSeconds < 2.5 ) over window:time(2s) from entry-point "PERCEPTION_STREAM";
        $count : count(1),
        $ttc : min($sample);
        $count >= 3
    )
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.EMERGENCY_BRAKE,
        0.0,
        RiskLevel.CRITICAL,
        DecisionPriority.EMERGENCY_SAFETY,
        "Persistent TTC critical across recent samples",
        drools.getRule().getName(),
        "count=" + $count + ", lowest TTC=" + $ttc + " s"
    );
end

rule "Emergency brake when TTC is immediately critical"
agenda-group "decision"
salience 890
when
    $ctx : DecisionContext()
    $e : TTCEvent( ttcSeconds > 0.0, $ttc : ttcSeconds < 1.3 ) over window:time(200ms) from entry-point "PERCEPTION_STREAM"
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.EMERGENCY_BRAKE,
        0.0,
        RiskLevel.CRITICAL,
        DecisionPriority.EMERGENCY_SAFETY,
        "Immediate TTC critical condition",
        drools.getRule().getName(),
        "TTC=" + $ttc + "s from target=" + $e.getTargetId()
    );
end

rule "Emergency stop for pedestrian extremely close"
agenda-group "decision"
salience 880
when
    $ctx : DecisionContext()
    PedestrianStateFact( inPath == true || crossingState == PedestrianCrossingState.CROSSING, $distance : distanceMeters <= 6.0 )
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.EMERGENCY_BRAKE,
        0.0,
        RiskLevel.CRITICAL,
        DecisionPriority.EMERGENCY_SAFETY,
        "Pedestrian critical distance in current path",
        drools.getRule().getName(),
        "distance=" + $distance + "m"
    );
end

// The obstacle is critical only in the lane the vehicle is physically in: a vehicle
// steering out of the obstacle's lane is past it once its lateral position has left that
// lane, even while the committed lane (which settles after the actuator) is still the old
// one. Otherwise every avoidance that passed close to the obstacle ended with a hard brake
// for an obstacle the vehicle was no longer heading for.
rule "Emergency braking for high severity obstacle at critical distance"
agenda-group "decision"
salience 870
when
    $ctx : DecisionContext()
    VehicleStateFact( $lane : physicalLane )
    $obs : ObstacleDetectedEvent( lane == $lane, distanceMeters > 0, $d : distanceMeters <= 8.0, severity.toString() == "HIGH" )
        over window:time(300ms) from entry-point "ROAD_STREAM"
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.EMERGENCY_BRAKE,
        0.0,
        RiskLevel.CRITICAL,
        DecisionPriority.EMERGENCY_SAFETY,
        "High severity obstacle critically close",
        drools.getRule().getName(),
        "obstacle=" + $obs.getObstacleId() + ", distance=" + $d + "m"
    );
end
