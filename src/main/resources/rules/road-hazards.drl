package rules

import com.one2drive.projeto1.decision.DecisionContext
import com.one2drive.projeto1.decision.DecisionPriority
import com.one2drive.projeto1.domain.DrivingAction
import com.one2drive.projeto1.domain.Lane
import com.one2drive.projeto1.domain.LaneChangeState
import com.one2drive.projeto1.domain.RiskLevel
import com.one2drive.projeto1.domain.RoadMarkingType
import com.one2drive.projeto1.drools.DroolsSupport
import com.one2drive.projeto1.drools.facts.LaneOccupancyState
import com.one2drive.projeto1.drools.facts.ObstacleStateFact
import com.one2drive.projeto1.drools.facts.PotholeStateFact
import com.one2drive.projeto1.drools.facts.VehicleStateFact

global DroolsSupport droolsSupport

rule "Pothole ahead reduce speed"
agenda-group "decision"
salience 460
when
    $ctx : DecisionContext()
    VehicleStateFact(laneChangeState == LaneChangeState.IDLE)
    PotholeStateFact(potholeId != "none", $distance : distanceMeters > 0, distanceMeters <= 40.0)
    (
        (VehicleStateFact(lane == Lane.CENTER) and LaneOccupancyState(lane == Lane.LEFT, occupied == true) and LaneOccupancyState(lane == Lane.RIGHT, occupied == true))
        or
        (VehicleStateFact(lane == Lane.LEFT) and LaneOccupancyState(lane == Lane.RIGHT, occupied == true))
        or
        (VehicleStateFact(lane == Lane.RIGHT) and LaneOccupancyState(lane == Lane.LEFT, occupied == true))
    )
then
    double target = 30.0;
    if ($distance < 15) {
        target = 20.0;
    }
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.REDUCE_SPEED,
        target,
        RiskLevel.MODERATE,
        DecisionPriority.ROAD_HAZARD,
        "Pothole ahead requires speed reduction",
        drools.getRule().getName(),
        "distance=" + $distance + "m"
    );
end

// An obstacle in the vehicle's own lane with no free lane on either side (another
// hazard, a vehicle alongside or the road edge) cannot be avoided, so the car must
// come to rest before it, 10 m short: outside the 8 m emergency zone, so it can steer
// away once a lane opens. The car follows the speed from which comfortable braking
// (2.8 m/s2, as the actuator applies) stops in the room left; when the deceleration
// needed (v^2 / 2d) is more than comfortable braking gives, it brakes hard instead.
rule "Stop before obstacle when no lane is free"
agenda-group "decision"
salience 465
when
    $ctx : DecisionContext()
    VehicleStateFact($lane : lane, $speed : speedKmh)
    ObstacleStateFact(obstacleId != "none", lane == $lane,
                      $distance : distanceMeters > 0, distanceMeters <= 60.0)
    LaneOccupancyState(lane == Lane.LEFT, occupied == true)
    LaneOccupancyState(lane == Lane.RIGHT, occupied == true)
then
    double room = Math.max(0.0, $distance - 10.0);
    double speedMps = $speed / 3.6;
    DrivingAction action = DrivingAction.BRAKE;
    double target = Math.sqrt(2.0 * 2.8 * room) * 3.6;
    if (room <= 0.5) {
        action = DrivingAction.STOP;
        target = 0.0;
    } else if (speedMps * speedMps / (2.0 * room) > 2.8 * 1.1) {
        action = DrivingAction.EMERGENCY_BRAKE;
        target = 0.0;
    }
    droolsSupport.proposeDecision(
        $ctx,
        action,
        target,
        RiskLevel.HIGH,
        DecisionPriority.COLLISION_AVOIDANCE,
        "Obstacle ahead and no free lane to avoid it",
        drools.getRule().getName(),
        "obstacle " + $distance + "m ahead in own lane, both sides blocked"
    );
end

// The obstacle fills the ego lane and no side can be entered (the blind-spot occupancy
// already counts a continuous line, like the road edge, as a closed side), and a
// continuous line is what closes at least one of them: the explanation names the law,
// not just the traffic. The line a change crosses follows WorldState.getMarkingBetween:
// leftMarking lies between LEFT and CENTER, rightMarking between CENTER and RIGHT.
rule "Stop before obstacle when lane change prohibited by continuous line"
agenda-group "decision"
salience 466
when
    $ctx : DecisionContext()
    VehicleStateFact($lane : lane, $speed : speedKmh, $left : leftMarking, $right : rightMarking)
    ObstacleStateFact(obstacleId != "none", lane == $lane,
                      $distance : distanceMeters > 0, distanceMeters <= 60.0)
    LaneOccupancyState(lane == Lane.LEFT, $leftSafe : safeToEnter)
    LaneOccupancyState(lane == Lane.RIGHT, $rightSafe : safeToEnter)
    eval(!$leftSafe && !$rightSafe
        && (($lane == Lane.CENTER && ($left == RoadMarkingType.CONTINUOUS || $right == RoadMarkingType.CONTINUOUS))
            || ($lane == Lane.RIGHT && $right == RoadMarkingType.CONTINUOUS)
            || ($lane == Lane.LEFT && $left == RoadMarkingType.CONTINUOUS)))
then
    double room = Math.max(0.0, $distance - 10.0);
    DrivingAction action = DrivingAction.BRAKE;
    double target = Math.sqrt(2.0 * 2.8 * room) * 3.6;
    if (room <= 0.5) {
        action = DrivingAction.STOP;
        target = 0.0;
    }
    droolsSupport.proposeDecision(
        $ctx,
        action,
        target,
        RiskLevel.HIGH,
        DecisionPriority.COLLISION_AVOIDANCE,
        "Continuous line prohibits lane change; stopping before obstacle",
        drools.getRule().getName(),
        "continuous line closes the free side, obstacle " + $distance + "m ahead"
    );
end
