package rules

import com.one2drive.projeto1.decision.DecisionContext
import com.one2drive.projeto1.decision.DecisionPriority
import com.one2drive.projeto1.domain.DrivingAction
import com.one2drive.projeto1.domain.RiskLevel
import com.one2drive.projeto1.drools.DroolsSupport
import com.one2drive.projeto1.drools.facts.RoundaboutStateFact

global DroolsSupport droolsSupport

rule "Reduce speed when approaching roundabout"
salience 410
when
    $ctx : DecisionContext()
    RoundaboutStateFact(roundaboutId != "none", $distance : distanceMeters > 0, distanceMeters <= 80.0, $approach : approachSpeedKmh)
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.REDUCE_SPEED,
        $approach,
        RiskLevel.MODERATE,
        DecisionPriority.ROAD_HAZARD,
        "Approaching roundabout",
        drools.getRule().getName(),
        "distance=" + $distance + "m, approachSpeed=" + $approach + " km/h"
    );
end

rule "Wait at occupied roundabout entry"
salience 430
when
    $ctx : DecisionContext()
    RoundaboutStateFact(roundaboutId != "none", occupied == true, distanceMeters <= 25.0)
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.WAIT,
        0.0,
        RiskLevel.HIGH,
        DecisionPriority.MANEUVER_SAFETY,
        "Roundabout occupied, wait before entry",
        drools.getRule().getName(),
        "occupancy=true"
    );
end

rule "Proceed through clear roundabout"
salience 190
when
    $ctx : DecisionContext(priority < DecisionPriority.MANEUVER_SAFETY)
    RoundaboutStateFact(roundaboutId != "none", occupied == false, distanceMeters <= 20.0, $approach : approachSpeedKmh)
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.CONTINUE,
        $approach,
        RiskLevel.LOW,
        DecisionPriority.COMFORT_PROGRESS,
        "Roundabout clear, continue",
        drools.getRule().getName(),
        "occupancy=false"
    );
end
