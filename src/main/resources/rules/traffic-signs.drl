package rules

import com.one2drive.projeto1.decision.DecisionContext
import com.one2drive.projeto1.decision.DecisionPriority
import com.one2drive.projeto1.decision.DrivingDecision
import com.one2drive.projeto1.domain.DrivingAction
import com.one2drive.projeto1.domain.RiskLevel
import com.one2drive.projeto1.drools.DroolsSupport
import com.one2drive.projeto1.drools.events.StoppedAtStopLineEvent
import com.one2drive.projeto1.drools.events.VehicleSpeedEvent
import com.one2drive.projeto1.drools.facts.CurrentSpeedLimit
import com.one2drive.projeto1.drools.facts.StopSignState
import com.one2drive.projeto1.drools.facts.VehicleStateFact

global DroolsSupport droolsSupport

// The camera sees a stop sign as far as 120 m ahead, so the approach follows the
// braking curve instead of a fixed window: slowing may only start when comfortable
// braking (2.8 m/s2, as the actuator applies) still stops the vehicle before the line.
// The curve decides WHEN to brake and when to coast, the margin being a full 2 m short
// of the sign so the vehicle comes to rest while the sign is still in view. Starting
// only 35 m out left too little room to stop, the vehicle crossed the line still moving,
// lost the sign behind it and the whole requirement was then cleared as stale
// perception, leaving the vehicle rolling on at the speed it crossed with.
//
// The rule stays alive over the whole final approach: the gate is the 2.0 m/s2 curve,
// the weakest deceleration the actuator ever applies, and not the 2.8 m/s2 curve itself.
// Gating on the braking curve made the rule switch off every time braking dipped the
// vehicle under it, so the baseline took the decision for a tick and the approach
// flickered between two rules, between braking and coasting, and (once the room ran
// out) between EMERGENCY_BRAKE and everything else, which also flashed the hazard
// lights. Holding the rule through that dip keeps one owner for the decision.
//
// Whether to brake hard is then decided from the stopping distance itself: how far
// beyond the 2 m margin comfortable braking would still leave the vehicle. That
// quantity is held constant while the actuator brakes at its comfortable rate, so it
// neither flickers back into emergency braking while the vehicle is on the curve, nor
// stays silent when it really is too fast for the line.
//
// The recommended speed is deliberately NOT the braking curve. The actuator brakes
// towards the recommendation: at a gap above it of 0.1-2 km/h it applies a weakened,
// gap-proportional deceleration, and that band can never keep up with a target which
// itself drops by ~1 km/h per tick. Recommending the curve therefore left the vehicle
// a widening gap above it, which pushed the required deceleration back through the
// emergency threshold and turned the whole approach into repeated hard-brake bursts.
// Recommending the current speed instead (within the limit) lets the actuator's own
// comfortable deceleration run uninterrupted while this rule, and only this rule,
// decides each tick whether braking is still needed at all.
rule "Stop sign requires progressive deceleration"
agenda-group "decision"
salience 610
when
    $ctx : DecisionContext()
    StopSignState( signId != "none", satisfied == false,
                   $distance : distanceMeters > 4.0, distanceMeters <= 125.0 )
    VehicleStateFact( $speed : speedKmh )
    CurrentSpeedLimit( $limit : limitKmh )
    $previous : DrivingDecision()
    eval( $speed / 3.6 > Math.sqrt(2.0 * 2.0 * Math.max(0.0, $distance - 2.0)) )
then
    double room = Math.max(0.0, $distance - 2.0);
    double speedMps = $speed / 3.6;
    double curve = Math.sqrt(2.0 * 2.8 * room) * 3.6;
    // How far beyond the 2 m margin comfortable braking would bring the vehicle to rest,
    // i. the stop point sits at (2 - shortfall) metres in front of the sign.
    double shortfall = speedMps * speedMps / (2.0 * 2.8) - room;
    boolean wasEmergency = $previous.getAction() == DrivingAction.EMERGENCY_BRAKE
        && $previous.getSourceRule() != null
        && $previous.getSourceRule().startsWith("Stop sign");

    DrivingAction action;
    double target;
    RiskLevel risk;
    String reason;
    if (shortfall > 3.0 || (wasEmergency && shortfall > 1.0)) {
        // Comfortable braking would now stop the vehicle more than 1 m past the line, so
        // it must brake hard instead of crossing still moving, exactly as it does before
        // an obstacle it cannot steer around. Hard braking is held only until comfortable
        // braking would again stop it at least 1 m before the line: one continuous burst,
        // no hazard lights flashing on and off, and no undershoot that leaves the vehicle
        // waiting well short of the sign for something else to pull it forward.
        action = DrivingAction.EMERGENCY_BRAKE;
        target = 0.0;
        risk = RiskLevel.HIGH;
        reason = "Stop sign ahead; comfortable braking no longer stops in time";
    } else if ($speed > curve) {
        action = DrivingAction.REDUCE_SPEED;
        target = Math.min($speed, $limit);
        risk = RiskLevel.MODERATE;
        reason = "Approaching stop sign; decelerate to stop at the line";
    } else {
        // Room is enough for now: coast back onto the curve, still holding the stop
        // requirement (and the current speed limit) so nothing else pulls the vehicle
        // away from it while the line is this close.
        action = DrivingAction.MAINTAIN_SPEED;
        target = Math.min($speed, $limit);
        risk = RiskLevel.LOW;
        reason = "Approaching stop sign; hold speed until the stop line";
    }
    droolsSupport.proposeDecision(
        $ctx,
        action,
        target,
        risk,
        DecisionPriority.LEGAL_MANDATORY_STOP,
        reason,
        drools.getRule().getName(),
        "distance=" + $distance + "m"
    );
end

rule "Stop sign requires full stop near line"
agenda-group "decision"
salience 620
when
    $ctx : DecisionContext()
    // Until the hold below is satisfied: that rule fires first (salience 635), so once the
    // vehicle has been at rest 1.2 s the stop sign is satisfied before this one is reached.
    $stop : StopSignState( signId != "none", satisfied == false, $distance : distanceMeters <= 4.0 )
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.STOP,
        0.0,
        RiskLevel.HIGH,
        DecisionPriority.LEGAL_MANDATORY_STOP,
        "Stop sign reached; full stop required",
        drools.getRule().getName(),
        "distance=" + $distance + "m"
    );
end

// The full stop is timed by CEP (Allen's interval algebra): the instant the vehicle comes to
// rest at the line is a StoppedAtStopLineEvent, and the stop is complete once a speed reading
// comes at least 1.2 s after it (after[1200ms]).
rule "Start stop timer once vehicle is stopped"
agenda-group "decision"
salience 630
when
    $stop : StopSignState($id : signId != "none", satisfied == false, distanceMeters <= 4.0)
    not StoppedAtStopLineEvent(signId == $id)
    VehicleStateFact($speed : speedKmh, $now : timestamp)
    eval($speed < 0.6)
then
    insert(new StoppedAtStopLineEvent($now, $id));
end

rule "Stop sign condition satisfied after full stop hold"
agenda-group "decision"
no-loop true
salience 635
when
    $stop : StopSignState($id : signId != "none", satisfied == false)
    $stopped : StoppedAtStopLineEvent(signId == $id)
    exists VehicleSpeedEvent(this after[1200ms] $stopped) from entry-point "VEHICLE_STREAM"
then
    $stop.setSatisfied(true);
    update($stop);
end

// The stop counts for one approach to the sign: it is forgotten when the sign is seen again
// from afar (more than 8 m to the line), or when the sign is no longer perceived.
rule "Forget the stop when the stop sign is re-armed"
agenda-group "decision"
salience 640
when
    $stopped : StoppedAtStopLineEvent($id : signId)
    StopSignState(signId != $id || distanceMeters > 8.0)
then
    delete($stopped);
end

rule "Proceed after stop sign condition satisfied"
agenda-group "decision"
salience 200
when
    $ctx : DecisionContext()
    StopSignState(signId != "none", satisfied == true, $distance : distanceMeters <= 4.0)
then
    droolsSupport.proposeDecision(
        $ctx,
        DrivingAction.CONTINUE,
        25.0,
        RiskLevel.LOW,
        DecisionPriority.MANEUVER_SAFETY,
        "Stop completed; proceed when safe",
        drools.getRule().getName(),
        "distance=" + $distance + "m"
    );
end
